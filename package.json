{
  "name": "folio-pdf-studio",
  "productName": "Folio PDF Studio",
  "version": "1.0.0",
  "private": true,
  "description": "A single-screen PDF text editor with context-aware typography and page replacement.",
  "main": "electron/main.cjs",
  "author": {
    "name": "Folio Studio"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "smoke": "electron . --smoke-test --no-sandbox"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "37.10.3",
    "electron-builder": "26.18.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "^1.64.1",
    "tslib": "^2.8.1"
  },
  "build": {
    "appId": "com.folio.pdfstudio.desktop",
    "productName": "Folio PDF Studio",
    "copyright": "Copyright © 2026 Folio Studio",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "index.html",
          "styles.css",
          "favicon.svg",
          "src/**/*",
          "vendor/**/*",
          "sample.pdf",
          "sample-replacement.pdf"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Folio-PDF-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio PDF Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer-fix.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "Folio-PDF-Studio-Setup-${version}.${ext}"
    }
  }
}
